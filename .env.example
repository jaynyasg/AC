# Chatbot — required at runtime (api/chat) and for `npm run eval:record`.
OPENAI_API_KEY=sk-...
# Optional: override the bot model (default gpt-4o-mini).
# CHAT_MODEL=gpt-4o-mini

# Booking email — OPTIONAL. If both are set, api/booking emails the request via
# Resend. If unset, booking still succeeds (logged) and the UI shows call/email
# fallbacks, so the contact path is never a dead end.
RESEND_API_KEY=
BOOKING_TO_EMAIL=difeliceshvac@gmail.com

# Stripe membership checkout — OPTIONAL. Until these are set, the membership
# enroll buttons gracefully fall back to a call/email-to-enroll path (nothing
# errors). Set ALL of them in Vercel to make the buttons live, then redeploy.
# Each price id comes from a Stripe Dashboard Price; the env-var suffix matches
# the plan key (tuneup/seasonal/comfort), not the billing cadence.
STRIPE_SECRET_KEY=
STRIPE_PRICE_TUNEUP=
STRIPE_PRICE_SEASONAL=
STRIPE_PRICE_COMFORT=
# Stripe webhook signing secret (whsec_...) for api/stripe-webhook owner alerts.
# Distinct from the API key and distinct between test/live mode. Set it BEFORE
# registering the webhook endpoint in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=
# Recommended in production: the canonical site origin used to build Stripe
# success/cancel return URLs (e.g. https://difelices-hvac.vercel.app). If unset,
# only known *.vercel.app / localhost hosts are trusted for the redirect.
PUBLIC_BASE_URL=
