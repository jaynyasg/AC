# Chatbot — required at runtime (api/chat) and for `npm run eval:record`.
ANTHROPIC_API_KEY=sk-ant-...

# Booking email — OPTIONAL. If both are set, api/booking emails the request via
# Resend. If unset, booking still succeeds (logged) and the UI shows call/email
# fallbacks, so the contact path is never a dead end.
RESEND_API_KEY=
BOOKING_TO_EMAIL=difeliceshvac@gmail.com
